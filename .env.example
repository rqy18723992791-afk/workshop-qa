# ============ 车间智答 环境配置模板 ============
# 使用方式：复制本文件为 backend/.env 并填写实际值。
# backend/.env 已被 .gitignore 排除，严禁把真实密钥写进代码或提交进仓库。

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000

# ===== Ollama 本地模型 =====
OLLAMA_BASE_URL=http://localhost:11434
# 对话模型：按本机显存选 7B/8B 量化版，跑不动降到 4B
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# 中文向量模型
EMBED_MODEL=bge-m3
# 模型上下文长度（显存紧张可调小）
LLM_NUM_CTX=4096

# ===== Chroma 向量库 =====
CHROMA_DIR=data/chroma

# ===== 检索参数（端云路由依据）=====
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SIM=0.35

# ===== DeepSeek 云端兜底 =====
# 密钥只放这里；OpenAI 兼容接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
